# Copy to .env. Keep this file private and use separate MinIO credentials
# with access only to the photo bucket.
DB_HOST=postgres.tail877c9f.ts.net
DB_USER=postgres
DB_NAME=postgres
DB_PASSWORD=replace-with-a-long-random-password
MINIO_ENDPOINT=minio.tail877c9f.ts.net:8443
MINIO_SECURE=true
MINIO_BUCKET=archive-imgs
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key

# Generate a fresh, non-ephemeral auth key for the archive-admin Tailscale node.
# Keep the state volume when rotating this key; TS_AUTH_ONCE reuses the node identity.
TS_AUTH_KEY=tskey-auth-replace-with-a-fresh-key
